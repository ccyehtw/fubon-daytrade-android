<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 預設：禁止所有明文流量（HTTPS only） -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- GCP Server：允許連接到 Python service（HTTP，明文傳輸） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">35.238.60.31</domain>
    </domain-config>

    <!-- Debug ONLY：允許 emulator localhost HTTP，便於本機開發調試 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>  <!-- Android Emulator 對應 Host 的 IP -->
    </domain-config>
</network-security-config>